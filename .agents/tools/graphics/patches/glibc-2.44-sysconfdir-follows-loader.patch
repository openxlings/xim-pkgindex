+++ b/elf/Makefile
@@ -1739,6 +1739,7 @@
 		    -D'SLIBDIR="$(slibdir)"'
 libof-ldconfig = ldconfig
 CFLAGS-dl-cache.c += $(SYSCONF-FLAGS)
+CFLAGS-dl-load.c += $(SYSCONF-FLAGS)
 CFLAGS-cache.c += $(SYSCONF-FLAGS)
 CFLAGS-rtld.c += $(SYSCONF-FLAGS)
 CFLAGS-dl-usage.c += $(SYSCONF-FLAGS) \
--- a/elf/dl-load.c
+++ b/elf/dl-load.c
@@ -46,6 +46,7 @@
 
 #include <dl-dst.h>
 #include <dl-load.h>
+#include <dl-cache.h>
 #include <dl-map-segments.h>
 #include <dl-map-segment-align.h>
 #include <dl-unmap-segments.h>
@@ -68,6 +69,27 @@
 
 /* This is the decomposed LD_LIBRARY_PATH search path.  */
 struct r_search_path_struct __rtld_env_path_list attribute_relro;
+
+/* The spelling used to invoke the loader determines the filesystem root.
+   Remove the parent component lexically: resolving a /lib64 symlink would
+   select /usr/etc instead of this root's etc.  These strings are immutable
+   after _dl_init_paths, just like the default search directories.  */
+static const char *xlings_cache_file attribute_relro = LD_SO_CACHE;
+static const char *xlings_preload_file attribute_relro
+  = SYSCONFDIR "/ld.so.preload";
+
+const char *
+_dl_xlings_cache_file (void)
+{
+  return xlings_cache_file;
+}
+
+const char *
+_dl_xlings_preload_file (void)
+{
+  return xlings_preload_file;
+}
+
 
 /* List of the hardware capabilities we might end up using.  */
 #ifdef SHARED
@@ -798,6 +820,23 @@
 
     if (self_dir != NULL && self_len > 0)
       {
+        size_t parent_len = self_len;
+        while (parent_len > 0 && self_dir[parent_len - 1] != '/')
+          --parent_len;
+        if (parent_len > 0)
+          --parent_len;
+        const char cache_suffix[] = "/etc/ld.so.cache";
+        const char preload_suffix[] = "/etc/ld.so.preload";
+        char *cache_path = malloc (parent_len + sizeof (cache_suffix));
+        char *preload_path = malloc (parent_len + sizeof (preload_suffix));
+        if (cache_path == NULL || preload_path == NULL)
+          _dl_fatal_printf ("cannot allocate loader configuration paths\n");
+        memcpy (cache_path, self_dir, parent_len);
+        memcpy (cache_path + parent_len, cache_suffix, sizeof (cache_suffix));
+        memcpy (preload_path, self_dir, parent_len);
+        memcpy (preload_path + parent_len, preload_suffix, sizeof (preload_suffix));
+        xlings_cache_file = cache_path;
+        xlings_preload_file = preload_path;
 	owned = malloc (self_len + 2);
 	if (owned != NULL)
 	  {
