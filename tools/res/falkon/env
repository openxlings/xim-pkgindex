# luban:falkon -- its programs run on luban:qt-runtime (the recipe's config()
# names their loader and library path); QtWebEngine's helper, resources and
# locales are this tree's. Without a GPU it composes in software; its
# Chromium sandbox needs user namespaces a Luban sandbox does not nest, and
# the system is the boundary (xlings design 2026-10-20 §20.2).
rt="$(cat "$here/libexec/falkon/qt-runtime" 2>/dev/null)/libexec/qt-runtime"
export QT_PLUGIN_PATH="$here/libexec/falkon/plugins:$rt/plugins"
export QML_IMPORT_PATH="$here/libexec/falkon/qml:$rt/qml" QML2_IMPORT_PATH="$here/libexec/falkon/qml:$rt/qml"
export QTWEBENGINEPROCESS_PATH="$here/libexec/falkon/bin/QtWebEngineProcess"
export QTWEBENGINE_RESOURCES_PATH="$here/share/qt6/resources"
export QTWEBENGINE_LOCALES_PATH="$here/share/qt6/translations/qtwebengine_locales"
export QTWEBENGINE_DISABLE_SANDBOX=1
export QTWEBENGINE_CHROMIUM_FLAGS="${QTWEBENGINE_CHROMIUM_FLAGS:---disable-gpu}"
unset rt
