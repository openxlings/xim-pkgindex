# luban:falkon -- its programs run on luban:qt-runtime (the recipe's config()
# names their loader and library path); QtWebEngine's helper, resources,
# locales and ICU's data are this tree's. Without a GPU it composes in software; its
# Chromium sandbox needs user namespaces a Luban sandbox does not nest, and
# the system is the boundary (xlings design 2026-10-20 §20.2).
rt="$(cat "$here/libexec/falkon/qt-runtime" 2>/dev/null)/libexec/qt-runtime"
export QT_PLUGIN_PATH="$here/libexec/falkon/plugins:$rt/plugins"
export QML_IMPORT_PATH="$here/libexec/falkon/qml:$rt/qml" QML2_IMPORT_PATH="$here/libexec/falkon/qml:$rt/qml"
export QTWEBENGINEPROCESS_PATH="$here/libexec/falkon/bin/QtWebEngineProcess"
export QTWEBENGINE_RESOURCES_PATH="$here/share/qt6/resources"
export QTWEBENGINE_LOCALES_PATH="$here/share/qt6/translations/qtwebengine_locales"
export QTWEBENGINE_DISABLE_SANDBOX=1
# ICU's whole data, this tree's (its line breaking, sorting, Chinese words).
for icu in "$here"/libexec/falkon/share/icu/*/; do export ICU_DATA="${icu%/}"; done
# The GPU when there is one to draw with (a render node this user opens);
# software otherwise (xlings design 2026-10-20 WuXian §7.6).
if [ -z "${QTWEBENGINE_CHROMIUM_FLAGS+x}" ]; then
    gpu=
    for node in /dev/dri/renderD*; do [ -r "$node" ] && [ -w "$node" ] && gpu=1; done
    [ -n "$gpu" ] || export QTWEBENGINE_CHROMIUM_FLAGS=--disable-gpu
    unset gpu node
fi
# A browser opens in a desktop: without one, said so -- not Qt's xcb errors.
if [ -z "${WAYLAND_DISPLAY}${DISPLAY}" ] && [ "${QT_QPA_PLATFORM:-}" != offscreen ]; then
    case "${1:-}" in
        -v|--version|-h|--help) ;;
        *) echo "falkon: there is no desktop here to open it in (open it in a desktop: luban enter <system> --display window)" >&2
           exit 1 ;;
    esac
fi
unset rt icu
