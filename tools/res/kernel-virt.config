# linux-kernel-virt: what a Luban machine under qemu/KVM boots with and
# nothing to load -- merged over <arch> defconfig + kvm_guest.config.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_SCSI_VIRTIO=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_TUN=y
# A Mac's Luban host machine (Virtualization.framework) shares its tree and a
# system's by virtio-fs, not 9p (xlings: Luban OS part 4 §6.6).
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
# KWin 6.8's software rendering allocates its buffers from /dev/udmabuf
# (xlings: 2026-10-18 Luban OS distribution design §13.3).
CONFIG_UDMABUF=y
