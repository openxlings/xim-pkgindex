alias left_ptr default
alias arrow default
alias top_left_arrow default
alias xterm text
alias ibeam text
alias hand1 pointer
alias hand2 pointer
alias pointing_hand pointer
alias openhand grab
alias closedhand grabbing
alias dnd-move grabbing
alias fleur move
alias all-scroll move
alias size_all move
